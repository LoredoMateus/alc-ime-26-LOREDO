import numpy as np

# =====================================================================
# DEMONSTRAÇÕES COMPUTACIONAIS DE ORTOGONALIDADE
# =====================================================================

def is_orthogonal_by_definition(A, tol=1e-4):
    """
    Verificação da ortogonalidade de uma matriz A através da Definição Formal.
    Uma matriz quadrada A é dita ortogonal se, e somente se, A^T A = I.
    """
    print("\n" + "-"*60)
    print("DEMONSTRAÇÃO 1: VERIFICAÇÃO PELA DEFINIÇÃO FORMAL (A^T A = I)")
    print("-" *60)
    
    linhas, colunas = A.shape
    identidade = np.eye(linhas)
    
    print("Calculando o produto da matriz transposta (A^T) pela matriz original (A):")
    produto = A.T @ A
    
    print("\nMatriz resultante (A^T A) aproximada para 4 casas decimais:")
    print(np.round(produto, decimals=4))
    
    print("\nMatriz Identidade esperada (I_n):")
    print(identidade)
    
    resultado = np.allclose(produto, identidade, atol=tol)
    
    print("\nConclusão da Demonstração 1:")
    if resultado:
        print("Como A^T A = I, satisfaz-se a definição. Portanto, a matriz A é ortogonal.")
    else:
        print("Como A^T A ≠ I, a condição falha. Portanto, a matriz A não é ortogonal.")
        
    return resultado


def is_orthogonal_by_vectors(A, tol=1e-4):
    """
    Verificação da ortogonalidade de uma matriz A analisando seus vetores coluna.
    O conjunto de vetores coluna deve formar uma base ortonormal, isto é:
    1. ||v_j|| = 1 para todo j (vetores unitários).
    2. <v_i, v_j> = 0 para i ≠ j (vetores mutuamente ortogonais).
    """
    print("\n" + "-"*60)
    print("DEMONSTRAÇÃO 2: ANÁLISE DO CONJUNTO DE VETORES COLUNA")
    print("-" *60)
    
    linhas, colunas = A.shape
    
    print("\nEtapa 1: Verificação da Norma Euclidiana (Condição Unitária)")
    for j in range(colunas):
        coluna_atual = A[:, j]
        norma = np.linalg.norm(coluna_atual)
        print(f" -> Norma do vetor coluna v_{j+1}: ||v_{j+1}|| = {norma:.5f}")
        
        if not np.isclose(norma, 1.0, atol=tol):
            print(f"\nObservação: Como ||v_{j+1}|| ≠ 1, os vetores não são normais.")
            print("Conclusão: A matriz A não é ortogonal.")
            return False
            
    print("Verifica-se que todos os vetores coluna possuem norma estritamente unitária.")


    print("\nEtapa 2: Verificação do Produto Interno (Condição de Ortogonalidade)")
    for i in range(colunas):
        for j in range(i + 1, colunas):
            coluna_i = A[:, i]
            coluna_j = A[:, j]
            produto_interno = np.dot(coluna_i, coluna_j)
            print(f" -> Produto interno <v_{i+1}, v_{j+1}> = {produto_interno:.5f}")
            
            if not np.isclose(produto_interno, 0.0, atol=tol):
                print(f"\nObservação: Como <v_{i+1}, v_{j+1}> ≠ 0, os vetores não formam um ângulo reto.")
                print("Conclusão: A matriz A não é ortogonal.")
                return False
                
    print("Verifica-se que o produto interno entre vetores distintos é nulo (<v_i, v_j> = 0).")
    
    print("\nConclusão da Demonstração 2:")
    print("O conjunto de vetores coluna forma uma base ortonormal. Portanto, a matriz A é ortogonal.")
    return True


